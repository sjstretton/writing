@techreport{Lefournier2023,
  author = {Lefournier, Julien},
  title = {The Design Flaw in Sustainability-Linked Bonds},
  institution = {Chaire {\'E}nergie et Prosp{\'e}rit{\'e}},
  address = {Paris},
  type = {Working Paper},
  number = {06/2023},
  year = {2023},
  url = {https://chair-energy-prosperity.org/wp-content/uploads/2023/06/publication2023_design-flaw-Sustainability-Linked-Bonds_Lefournier_WP.pdf},
  note = {verified 31 Oct 2026, abstract and contents read: an SLB and a counterfactual vanilla bond of the same issuer should be and are priced at the same issuer yield; step-up size, period and activation probability cannot be set to lower the issuer's cost of capital significantly; a structural "design flaw" and a no-win situation for issuers and investors.}}
@techreport{MEF2023SSLL,
  author = {{Ministry of Economy and Finance, Uruguay}},
  title = {Uruguay: Green and Resilient Growth Development Policy Loan. Interest Rate Step-Down Mechanism to Incentivize Provision of Global Public Goods},
  institution = {Ministerio de Econom{\'i}a y Finanzas},
  type = {Briefing note},
  address = {Montevideo},
  year = {2023},
  month = dec,
  url = {https://sslburuguay.mef.gub.uy/innovaportal/file/30726/14/briefing-note-on-sovereign-sustainability-linked-loan-from-the-world-bank.pdf},
  note = {verified 31 Oct 2026, read in full: Board approval 16 Nov 2023; US\$350m; 15.5-year maturity, 4-year grace; principal US\$15.2m semi-annually April 2028-April 2039; KPI methane intensity of non-dairy beef cattle per unit of live weight vs truncated 1987-1991 average, IPCC 2006 methods, truncated five-year rolling average; targets 33 percent (NDC1 unconditional 32 percent) and 36 percent (NDC2 35 percent); latest value 28 percent (2018); 50 bp (max US\$6.7m, 2028-32) and 100 bp (max US\$5.8m, 2033-37), cap US\$12.5m; buffer year 2038 for one missed year; interest cannot become negative; higher step available a year early (2032, data for 2029); UNDP verifies under the UNFCCC peer-review guide; KPI for 2025 calculated 2027 and verified by May 2028; step applied to the next two semi-annual payments; standard IBRD alternative SOFR plus a variable spread of 109 bp; step-down only; Evolution Roadmap called for "long-term performance-based incentive mechanisms, including interest buydowns".}}
