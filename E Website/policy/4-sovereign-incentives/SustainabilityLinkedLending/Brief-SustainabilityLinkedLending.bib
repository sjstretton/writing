@unpublished{EstevaoAuthorZimmermann2024,
  author = {Estev{\~a}o, Marcello and {Author} and Zimmermann, Nils},
  title = {Mobilizing Private Finance for the Climate Agenda: Introducing Sustainability-Linked Intermediated Debt Instruments ({SLIDIs})},
  year = {2024},
  note = {Paper written in a personal capacity; published on the author's website. verified 31 Oct 2026: public on the author's website (E Website/policy/more.qmd links SLIDIs.docx). Read in full (3.RelatedPiecesAndLinks/SLIDIs/SLIDIs.qmd). Option 1: side payments from a World Bank or other trust fund to a sovereign that issues a fixed-coupon SLB, on meeting KPIs. Option 2 (recommended): a trusted intermediary backed by a coalition of advanced economies issues fixed-coupon bonds, on-lends as SLLs at a somewhat higher fixed rate, and refunds part of the interest paid when KPIs are met, at maturity or milestone years; development agencies monitor and give technical help. Argues variable coupons deter investors. The earlier "presented at a public debt management conference" note could not be verified and was dropped.}}
@article{Feldhutter2024,
  author = {Feldh{\"u}tter, Peter and Halskov, Kristoffer and Krebbers, Arthur},
  title = {Pricing of Sustainability-Linked Bonds},
  journal = {Journal of Financial Economics},
  volume = {162},
  pages = {103944},
  year = {2024},
  doi = {10.1016/j.jfineco.2024.103944},
  note = {verified 31 Oct 2026, full text (open access): label premium 1-2 bp (1.9 bp average sustainium); average probability of missing the target 14-39 percent, so targets are easy; prices depend strongly on the size of the potential penalty; no evidence of mispricing, contrary to Kolbel and Lambillon; 52 percent of SLBs with a step-up use 25 bp.}}
