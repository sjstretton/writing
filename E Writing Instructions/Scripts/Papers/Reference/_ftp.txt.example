# Rename this file to _ftp.txt and fill it in. It is excluded by .gitignore,
# so what you put here never reaches GitHub.
#
# A.Website\deploy.bat reads its FTP login from this file. Change the password
# on the server: the old one is in the repository's history.

host     = ftp.example.com
user     = someone
password = 
remote   = /public_html
protocol = ftp
url      = https://www.example.com

# remote is the folder the website is served from, as this FTP login sees it.
# If the login already opens inside public_html, use  remote = /
# If the site is an addon domain, it may be e.g.  remote = /public_html/example.com
# url is the live website: after uploading, Push-Website.bat checks that it shows the new pages.
